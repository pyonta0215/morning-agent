# Anthropic API キー
ANTHROPIC_API_KEY=sk-ant-...

# メール設定（SES で送信）
RECIPIENT_EMAIL=your-email@example.com
SENDER_EMAIL=sender@example.com
DELIVERY_TIME=07:00

# AWS設定（ローカル開発時）
AWS_REGION=ap-northeast-1
AWS_ACCOUNT=123456789012

# ローカル開発フラグ（SSM Parameter Store をスキップ）
LOCAL_DEV=true

# ドライラン（メール送信をスキップ）
# DRY_RUN=true
