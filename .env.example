# Anthropic API キー
ANTHROPIC_API_KEY=sk-ant-...

# メール設定（SES で送信）
RECIPIENT_EMAIL=your-email@example.com
SENDER_EMAIL=sender@example.com
DELIVERY_TIME=07:00

# AWS設定（ローカル開発時）
AWS_REGION=ap-northeast-1
AWS_ACCOUNT=123456789012  # CDK デプロイ時のみ使用（SES 送信には不要）

# AWS 認証情報（ローカル開発時）
# ~/.aws/credentials に設定済みの場合は不要
# 未設定の場合はここで指定するか `aws configure` で設定する
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_PROFILE=default  # 複数プロファイルがある場合

# ローカル開発フラグ（SSM Parameter Store をスキップ）
LOCAL_DEV=true

# ドライラン（メール送信をスキップ）
# DRY_RUN=true

# Web検索（Claude API web_search ツール）でニュースの鮮度を補強
# webSearch:true のトピック（現状 AI のみ）が対象。検索1回あたり $0.01。
# ENABLE_WEB_SEARCH=true
# WEB_SEARCH_MAX_USES=1
